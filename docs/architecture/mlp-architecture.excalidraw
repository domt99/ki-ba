   "text": "main:\n    self.config = readEnvFile()\n    self.dataPrep = createDataPrep( config.dataSetType )\n    validateConfig( self.config, self.dataPrep )\n    calculation = createCalculation( config.calculationType )\n    inputLayer, hiddenLayers, outputLayer =\n        createLayers( config.topology, config.activations, calculation, config.seed )\n    self.mlp = MLP( inputLayer, hiddenLayers, outputLayer )\n    self.optimizer = createOptimizer( config.optimizerType )\n    self.epochErrors = train()\nreadEnvFile() : Config\nvalidateConfig( config, dataPrep )\ncreateDataPrep( dataSetType ) : DataPrep\nloadMnist() : rawImages, rawLabels\ncreateCalculation( calculationType ) : Calculation\ncreateActivation( activationName ) : ActivationFunction\ncreateLayers( topology, activations, calculation, seed )\n    : inputLayer, hiddenLayers, outputLayer\ncreateOptimizer( optimizerType ) : Optimizer\ntrain() : List epochErrors\ntrainStep( imageBatch, labelBatch ) : errorValue",
   "originalText": "main:\n    self.config = readEnvFile()\n    self.dataPrep = createDataPrep( config.dataSetType )\n    validateConfig( self.config, self.dataPrep )\n    calculation = createCalculation( config.calculationType )\n    inputLayer, hiddenLayers, outputLayer =\n        createLayers( config.topology, config.activations, calculation, config.seed )\n    self.mlp = MLP( inputLayer, hiddenLayers, outputLayer )\n    self.optimizer = createOptimizer( config.optimizerType )\n    self.epochErrors = train()\nreadEnvFile() : Config\nvalidateConfig( config, dataPrep )\ncreateDataPrep( dataSetType ) : DataPrep\nloadMnist() : rawImages, rawLabels\ncreateCalculation( calculationType ) : Calculation\ncreateActivation( activationName ) : ActivationFunction\ncreateLayers( topology, activations, calculation, seed )\n    : inputLayer, hiddenLayers, outputLayer\ncreateOptimizer( optimizerType ) : Optimizer\ntrain() : List epochErrors\ntrainStep( imageBatch, labelBatch ) : errorValue",
