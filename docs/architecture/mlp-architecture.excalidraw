   "link": null,
   "locked": false,
   "text": "main:\n    readEnvFile() : epochCount, batchSize, layerCount, neuronPerLayerCount,\n        optimizerType, calculationType, alpha, beta_1, beta_2, epsilon,\n        Array Activation Functions\n    new DataPrep = DataPrep()\n    self.Optimizer = createOptimizer( OPTIMIZERTYPE )\n    self.Calculation = createCalculation( CALCULATIONTYPE )\n    iterates over epoches\n        miniBatches = randomizeData( batchsize )\n        iterates: for currentBatch in miniBatches\n            InputLayer = InputLayer( neuronCount )\n            OutputLayer = OutputLayer( neuronCount, neuronCountPrev, calculation )\n            LOOP: HiddenLayer = HiddenLayer( neuronCount, neuronCountPrev, calculation )\n            trainModel()\n    initializeGradients() : gradienten",
   "originalText": "main:\n    readEnvFile() : epochCount, batchSize, layerCount, neuronPerLayerCount,\n        optimizerType, calculationType, alpha, beta_1, beta_2, epsilon,\n        Array Activation Functions\n    new DataPrep = DataPrep()\n    self.Optimizer = createOptimizer( OPTIMIZERTYPE )\n    self.Calculation = createCalculation( CALCULATIONTYPE )\n    iterates over epoches\n        miniBatches = randomizeData( batchsize )\n        iterates: for currentBatch in miniBatches\n            InputLayer = InputLayer( neuronCount )\n            OutputLayer = OutputLayer( neuronCount, neuronCountPrev, calculation )\n            LOOP: HiddenLayer = HiddenLayer( neuronCount, neuronCountPrev, calculation )\n            trainModel()\n    initializeGradients() : gradienten",
   "fontSize": 16,
   "fontFamily": 6,
