DATASET_TYPE=mnist
TOPOLOGY=784,128,64,10
ACTIVATIONS=relu
CALCULATION_TYPE=matrix
OPTIMIZER_TYPE=rprop
# Rprop needs full batch (one weight update per epoch), hence many epochs (~4 min)
EPOCH_COUNT=100
BATCH_SIZE=50000
SEED=42
# initial step size (Igel & Hüsken 2003); the default 0.5 only reaches ~66 % val after 100 epochs
DELTA_NULL=0.0125
