# Copy to .env (cp .env.example .env) and pick a run configuration.
#
# Option 1: use a template from configs/. All other keys in this file are then ignored.
TEMPLATE=mnist-adam.env
#
# Option 2: no TEMPLATE, set the keys directly:
# DATASET_TYPE=mnist
# TOPOLOGY=784,128,64,10              # input, hidden..., output neurons
# ACTIVATIONS=relu                    # one per hidden layer, or one for all:
#                                     # relu | sigmoid_log | sigmoid_tanh | identity
# CALCULATION_TYPE=matrix             # loop | matrix
# OPTIMIZER_TYPE=adam                 # gradient_descent | rprop | adam
# EPOCH_COUNT=10
# BATCH_SIZE=32
# SEED=42
# LEARNING_RATE=0.001                 # gradient_descent and adam (as alpha); not used by rprop
